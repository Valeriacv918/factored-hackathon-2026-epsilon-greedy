{
  "name": "list_cards",
  "description": "List the customer's credit and debit cards with status and last 4 digits.",
  "input_schema": {
    "properties": {
      "session_token": {
        "description": "session_token from verify_identity.",
        "maxLength": 512,
        "minLength": 1,
        "title": "Session Token",
        "type": "string"
      }
    },
    "required": [
      "session_token"
    ],
    "title": "list_cardsArguments",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Card": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "customer_id": {
            "title": "Customer Id",
            "type": "string"
          },
          "last4": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last4"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer_id",
          "last4",
          "status",
          "type"
        ],
        "title": "Card",
        "type": "object"
      }
    },
    "properties": {
      "cards": {
        "items": {
          "$ref": "#/$defs/Card"
        },
        "title": "Cards",
        "type": "array"
      }
    },
    "required": [
      "cards"
    ],
    "title": "CardList",
    "type": "object"
  }
}
