{
  "name": "verify_identity",
  "description": "Check the customer's identity: document number, date of birth and one of their product numbers.\n\n    On success returns the customer_id, a session_token for the other tools and the\n    customer's product numbers. Returns status \"failed\" without saying which value was\n    wrong, and \"locked\" after too many failures. Never returns the customer's data.\n    ",
  "input_schema": {
    "properties": {
      "document_number": {
        "description": "Identity document number the customer gave (cédula, CURP, DNI...).",
        "pattern": "^[A-Za-z0-9 .-]{4,40}$",
        "title": "Document Number",
        "type": "string"
      },
      "date_of_birth": {
        "format": "date",
        "title": "Date Of Birth",
        "type": "string"
      },
      "product_number": {
        "description": "Number of one of the customer's products (card or account).",
        "pattern": "^[A-Za-z0-9 -]{4,40}$",
        "title": "Product Number",
        "type": "string"
      }
    },
    "required": [
      "document_number",
      "date_of_birth",
      "product_number"
    ],
    "title": "verify_identityArguments",
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "status": {
        "enum": [
          "verified",
          "failed",
          "locked"
        ],
        "title": "Status",
        "type": "string"
      },
      "customer_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Customer Id"
      },
      "session_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Session Token"
      },
      "product_numbers": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Product Numbers",
        "type": "array"
      },
      "attempts_left": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Attempts Left"
      },
      "locked_until": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Locked Until"
      },
      "expires_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expires At"
      }
    },
    "required": [
      "status"
    ],
    "title": "IdentityResult",
    "type": "object"
  }
}
