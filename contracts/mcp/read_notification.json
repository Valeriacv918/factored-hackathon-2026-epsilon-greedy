{
  "name": "read_notification",
  "description": "Read a notification back from the sandbox. verified=true means the SIMULATED record\nis stored and points to the customer's ticket, not that anyone received it.",
  "input_schema": {
    "properties": {
      "session_token": {
        "description": "session_token from verify_identity.",
        "maxLength": 512,
        "minLength": 1,
        "title": "Session Token",
        "type": "string"
      },
      "id": {
        "description": "id returned by the write.",
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "title": "Id",
        "type": "string"
      }
    },
    "required": [
      "session_token",
      "id"
    ],
    "title": "read_notificationArguments",
    "type": "object"
  },
  "output_schema": {
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "ticket_id": {
        "title": "Ticket Id",
        "type": "string"
      },
      "customer_id": {
        "title": "Customer Id",
        "type": "string"
      },
      "status": {
        "title": "Status",
        "type": "string"
      },
      "verified": {
        "title": "Verified",
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "ticket_id",
      "customer_id",
      "status",
      "verified"
    ],
    "title": "NotificationRecord",
    "type": "object"
  }
}
