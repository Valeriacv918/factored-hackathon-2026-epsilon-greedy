# Copy to .env at the repo root. Read by apps/agent, apps/mcp-server and scripts/.
# GCP auth is ADC (gcloud auth application-default login). Do not commit credential contents.

# --- MCP server (apps/mcp-server) ---
BQ_PROJECT=hackaton-509923
BQ_DATASET=bank_curated
BQ_LOCATION=us-central1
# Simulated card blocks and disputes (docs/mcp-sandbox.md). Empty: those tools are
# disabled and cards show their curated status. Create the scenario first with
# infra/bigquery/sandbox/create_scenario.sql; on Cloud Run use --set-env-vars instead.
SANDBOX_SCENARIO_ID=
BQ_SANDBOX_DATASET=bank_sandbox
# Optional limits (defaults shown)
# MAX_BYTES_BILLED=1000000000
# MAX_ROWS=200
# QUERY_TIMEOUT_S=30
# RATE_LIMIT_PER_MIN=60

# --- Agent -> MCP connection ---
MCP_SERVER_URL=
# stdio command when MCP_SERVER_URL is empty (run from the repo root)
MCP_SERVER_COMMAND=uv run --project apps/mcp-server bank-mcp

# --- Scenario clock and sessions ---
# Scenario clock for historical demo data, with timezone, e.g. 2026-06-18T12:00:00+00:00
# With SANDBOX_SCENARIO_ID set, use the scenario's scenario_clock: the server searches
# and counts disputes from that clock, and the agent's policy uses this one.
SCENARIO_NOW=
# Signs MCP session tokens (32+ chars). Secret: Secret Manager in production.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=
# Development-only sessions: ref=TOKEN[,ref2=TOKEN2]
# TOKEN from: uv run --project apps/mcp-server bank-mcp-token CUSTOMER_ID
DEV_SESSIONS=

# --- Logging (JSON lines; apps/agent/src/bank_agent/observability.py) ---
# LOG_FILE: write events here instead of stdout (scripts/run_disputes.py defaults to logs/agent.jsonl).
LOG_FILE=
LOG_LEVEL=INFO
# 1 = also log LLM prompts and outputs. Local debugging only: they include identity factors.
LOG_LLM_CONTENT=

# --- LLM ---
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
