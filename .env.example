# Copy to .env at the repo root. Read by apps/agent, apps/mcp-server and scripts/.
# GCP auth is ADC (gcloud auth application-default login). Do not commit credential contents.

# =====================================================================
# 1. Required to run the web app (uv run --project apps/agent bank-web)
# =====================================================================

# Demo scenario in bank_sandbox, where simulated card blocks, disputes, handoffs and
# notifications are written (docs/mcp-sandbox.md). Create a new one with
# infra/bigquery/sandbox/create_scenario.sql. Empty: sandbox tools are disabled.
SANDBOX_SCENARIO_ID=jury-20261005-99546af8bf
# The scenario's clock (the demo data is historical). Must include a timezone.
SCENARIO_NOW=2026-06-19T12:00:00+00:00
# Signs MCP session tokens (32+ chars). Secret: Secret Manager in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=
# LLM provider key (https://console.groq.com/keys)
GROQ_API_KEY=

# =====================================================================
# 2. Defaults that normally stay as they are
# =====================================================================

BQ_PROJECT=hackaton-509923
BQ_DATASET=bank_curated
BQ_LOCATION=us-central1
BQ_SANDBOX_DATASET=bank_sandbox
LLM_MODEL=groq:openai/gpt-oss-120b
# Empty: the agent starts the MCP server itself over stdio with MCP_SERVER_COMMAND.
# Set to a URL only when the MCP server runs separately (bank-mcp --http).
MCP_SERVER_URL=
# Run from the repo root.
MCP_SERVER_COMMAND=uv run --project apps/mcp-server bank-mcp

# =====================================================================
# 3. Only for CLI scripts (scripts/run_disputes.py, chat_*.py) and integration tests
# =====================================================================
# The web app ignores this: it always authenticates with the identity form.
# Development sessions that skip identity validation: ref=TOKEN[,ref2=TOKEN2]
# TOKEN from: uv run --project apps/mcp-server bank-mcp-token CUSTOMER_ID
# Integration tests use the "dev" entry: DEV_SESSIONS=dev=TOKEN
DEV_SESSIONS=

# =====================================================================
# 4. Optional (defaults shown; uncomment to change)
# =====================================================================

# --- Logging (JSON lines; apps/agent/src/bank_agent/observability.py) ---
# Write events here instead of stdout (scripts/run_disputes.py defaults to logs/agent.jsonl).
# LOG_FILE=
# LOG_LEVEL=INFO
# 1 = also log LLM prompts and outputs. Local debugging only: they include identity factors.
# LOG_LLM_CONTENT=

# --- Web app (apps/agent/src/bank_agent/web) ---
# HOST=0.0.0.0
# PORT=8080
# USD per million tokens, for the cost estimate in the stats panel. Check the model's current price.
# LLM_PRICE_INPUT_PER_MTOK=0.15
# LLM_PRICE_OUTPUT_PER_MTOK=0.75
# Offline triage evaluation results shown in the stats panel (default evals/cases/results).
# EVAL_RESULTS_DIR=

# --- MCP server limits (apps/mcp-server/src/bank_mcp/config/settings.py) ---
# Project billed for queries (default BQ_PROJECT).
# BQ_BILLING_PROJECT=
# MAX_BYTES_BILLED=1000000000
# MAX_ROWS=200
# QUERY_TIMEOUT_S=30
# RATE_LIMIT_PER_MIN=60
# SESSION_TTL_MINUTES=15
# IDENTITY_MAX_ATTEMPTS=3
# IDENTITY_LOCKOUT_MINUTES=15
# Days of dispute history counted back from the scenario clock.
# DISPUTE_HISTORY_DAYS=90
# Amount tolerance (%) when matching a described charge to transactions.
# AMOUNT_TOLERANCE_PCT=10
