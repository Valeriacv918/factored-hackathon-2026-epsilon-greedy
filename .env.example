# Template for future applications. Existing data scripts have their own config.
GCP_PROJECT_ID=hackaton-509923
GCP_REGION=us-central1
BIGQUERY_CURATED_DATASET=bank_curated
BIGQUERY_OPS_DATASET=bank_ops
MCP_SERVER_URL=
# stdio command when MCP_SERVER_URL is empty (run from the repo root)
MCP_SERVER_COMMAND=uv run --project apps/mcp-server bank-mcp
# Scenario clock for historical demo data, with timezone, e.g. 2026-06-18T12:00:00+00:00
SCENARIO_NOW=
# Development-only sessions: ref=CUSTOMER_ID[,ref2=CUSTOMER_ID2]
DEV_SESSIONS=
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
# Use runtime service identity / ADC. Do not commit credential contents.
